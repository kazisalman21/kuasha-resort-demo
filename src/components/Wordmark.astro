---
import { site } from '../data/site';
interface Props { size?: 'sm'|'lg'; }
const { size = 'sm' } = Astro.props;
---
<span class:list={['wm', `wm--${size}`]}>
  <span class="wm__en">{site.name}</span>
  <span class="wm__bn bn" lang="bn" aria-hidden="true">{site.nameBn}</span>
</span>
<style>
  .wm { display: inline-flex; align-items: baseline; gap: .5em; line-height: 1; white-space: nowrap; }
  .wm__en { font-family: var(--f-serif); font-weight: 400; letter-spacing: .01em; font-size: 1.6rem; }
  .wm__bn { font-size: .95rem; opacity: .75; transform: translateY(-1px); }
  .wm--lg .wm__en { font-size: clamp(2.6rem, 6vw, 4rem); font-weight: 300; }
  .wm--lg .wm__bn { font-size: clamp(1.2rem, 2.4vw, 1.6rem); }
</style>

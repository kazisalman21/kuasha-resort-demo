---
import Pic from './Pic.astro';
import type { Experience } from '../data/site';
interface Props { e: Experience; sizes?: string; }
const { e, sizes = '(max-width: 699px) 80vw, (max-width: 1099px) 42vw, 26vw' } = Astro.props;
---
<article class="xc">
  <Pic name={e.img} ratio="4x5" sizes={sizes} />
  <p class="xc__meta label"><span>{e.duration}</span><span aria-hidden="true">·</span><span>{e.season}</span></p>
  <h3 class="h3 xc__t">{e.title}</h3>
  <p class="small muted xc__x">{e.text}</p>
  <p class="xc__p">{e.price}</p>
</article>
<style>
  .xc { display: grid; align-content: start; }
  .xc__meta { display: flex; gap: 8px; margin: var(--s-4) 0 var(--s-2); color: var(--ink-2); }
  .xc__t { margin-bottom: var(--s-2); }
  .xc__x { margin-bottom: var(--s-3); }
  .xc__p { font-family: var(--f-serif); color: var(--clay); font-size: 1.1rem; margin: 0; }
</style>

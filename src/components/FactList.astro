---
interface Props { items: { n: string; label: string }[]; cols?: number; }
const { items, cols = 2 } = Astro.props;
---
<dl class="facts" style={`--cols:${cols}`}>
  {items.map(f => <div class="facts__i"><dt class="facts__n num">{f.n}</dt><dd>{f.label}</dd></div>)}
</dl>
<style>
  .facts { display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--s-6) var(--s-6); margin: 0; }
  .facts__i { border-top: 1px solid var(--line-strong); padding-top: var(--s-4); }
  :global(.dark) .facts__i { border-color: var(--line-dark); }
  .facts__n { font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); line-height: 1; margin-bottom: 10px; }
  .facts dd { margin: 0; font-size: var(--t-small); color: var(--ink-2); max-width: 16em; }
  :global(.dark) .facts dd { color: var(--on-dark-2); }
  @media (max-width: 499px) { .facts { grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-4); } }
</style>

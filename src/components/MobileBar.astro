---
import { site } from '../data/site';
---
<nav class="mbar" aria-label="Quick contact" data-mbar>
  <a href={site.phoneHref} data-demo-contact="call">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.4 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.4v3a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    Call
  </a>
  <a href={`https://wa.me/${site.whatsapp}`} data-demo-contact="whatsapp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-3.6A8 8 0 1 1 8 19.1L4 20Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.6c.2 2.6 2.6 5.2 5.4 5.6l1-1.2-1.6-.9-.8.7c-1-.4-1.9-1.3-2.3-2.3l.7-.8-.9-1.6-1.2 1Z" fill="currentColor"/></svg>
    WhatsApp
  </a>
  <a href="/book/" class="mbar__book">Check dates</a>
</nav>
<style>
  .mbar { display: none; }
  @media (max-width: 699px) {
    .mbar { position: fixed; z-index: 55; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1fr 1.4fr;
      background: var(--paper); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom);
      transform: translateY(110%); transition: transform var(--d-base) var(--ease); box-shadow: 0 -8px 30px rgb(24 36 29 / .08); }
    .mbar.show { transform: none; }
    .mbar a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 60px; text-decoration: none; font-weight: 600; font-size: .92rem; }
    .mbar a + a { border-left: 1px solid var(--line); }
    .mbar svg { width: 20px; height: 20px; }
    .mbar__book { background: var(--tea); color: var(--paper); border-left: 0 !important; }
  }
</style>
